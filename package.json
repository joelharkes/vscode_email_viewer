{
  "name": "eml-email-viewer",
  "displayName": "EML Email viewer",
  "description": "View and inspect .eml email files with HTML rendering, attachments, and headers",
  "version": "1.0.2",
  "publisher": "joelharkes",
  "license": "MIT",
  "icon": "images/icon.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "eml",
    "email",
    "viewer",
    ".eml",
    "mime",
    "message"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joelharkes/vscode_email_viewer"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "emlviewer.eml",
        "displayName": "Email Viewer (eml)",
        "selector": [
          {
            "filenamePattern": "*.eml"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "8.x",
    "@typescript-eslint/parser": "8.x",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "postal-mime": "^2.4"
  }
}
