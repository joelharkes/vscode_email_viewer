{
  "name": "emlviewer",
  "displayName": "Email viewer (.eml files)",
  "description": "A viewer for EML mail files",
  "version": "0.0.1",
  "publisher": "joel-harkes",
  "license": "MIT",
  "icon": "images/icon.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages", "Other"
  ],
  "keywords": [
    "eml", "email", "viewer", ".eml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joelharkes/vscode_email_viewer"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emlviewer.helloWorld",
        "title": "Hello World"
      }
    ],
    "customEditors": [
      {
        "viewType": "emlviewer.eml",
        "displayName": "Email Viewer (eml)",
        "selector": [
          {
            "filenamePattern": "*.eml"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "8.x",
    "@typescript-eslint/parser": "8.x",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "postal-mime": "^2.4"
  }
}
